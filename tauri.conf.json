{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "npyz-viewer",
  "version": "0.2.0",
  "identifier": "net.masanoriakimoto.npyz-viewer",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "npyz-viewer",
        "width": 1240,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
