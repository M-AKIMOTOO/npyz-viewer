{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../../ui",
    "distDir": "../../ui",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "npyz-viewer",
    "version": "0.3.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "all": false,
        "open": true
      }
    },
    "bundle": {
      "active": false,
      "identifier": "net.masanoriakimoto.npyz-viewer",
      "icon": ["../../icons/icon.png"]
    },
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "title": "npyz-viewer",
        "width": 1240,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "fileDropEnabled": true
      }
    ]
  }
}
